# Salin file ini menjadi ".env" lalu isi nilainya. Jangan bagikan file .env ke siapa pun.

# API key Gemini dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Twilio WhatsApp. Account SID dan Auth Token ada di dasbor Twilio Console. PUBLIC_URL adalah alamat https dari ngrok,
# tanpa garis miring di akhir. Bila keduanya diisi, server menolak permintaan yang bukan dari Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_URL=
PORT=5000

# Cara membalas: teks (mode percobaan Try out WhatsApp), twiml (WhatsApp Sandbox), api (REST API Twilio)
CARA_BALAS=twiml

# PANTAU=1 menampilkan isi pesan dan jawaban di jendela server dan menyimpannya ke hasil/percakapan_whatsapp.csv
PANTAU=0
